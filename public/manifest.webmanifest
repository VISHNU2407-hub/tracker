{
  "name": "Life System",
  "short_name": "Life System",
  "description": "Private, local-first life tracker — habits, rules, daily progress and reflection.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef4fc",
  "theme_color": "#eef4fc",
  "categories": ["productivity", "lifestyle", "health"],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "url": "./#/today",
      "description": "Open today's tracking"
    },
    {
      "name": "Stats",
      "short_name": "Stats",
      "url": "./#/stats",
      "description": "View your stats"
    }
  ]
}
